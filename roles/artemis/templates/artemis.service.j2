{{ ansible_managed | comment }}

[Unit]
Description=Artemis
After=syslog.target

[Service]
User={{ artemis_user_name }}
WorkingDirectory={{ artemis_working_directory }}
# Tomcat can only remove its work directory on a graceful shutdown, so every kill leaves ~330 MB of unpacked jars
# behind. Sweep what no running Artemis owns before starting a new one.
ExecStartPre=/bin/sh -c 'rm -rf "{{ artemis_jvm_temp_directory }}"/tomcat.{{ artemis_server_port }}.*'
ExecStart=/usr/bin/java \
    -Djava.io.tmpdir={{ artemis_jvm_temp_directory }} \
    -Djdk.tls.ephemeralDHKeySize=2048 \
    -DLC_CTYPE=UTF-8 \
    -Dfile.encoding=UTF-8 \
    -Dsun.jnu.encoding=UTF-8 \
    -Djava.security.egd=file:/dev/./urandom \
    -Dhazelcast.slow.operation.detector.stacktrace.logging.enabled=true \
    -Xmx{{ [(artemis_system_ram_proportion * ansible_facts.memory_mb.real.total) | int, (ansible_facts.memory_mb.real.total - artemis_heap_reserve_mb) | int] | min }}m \
    -Dio.netty.leakDetection.level={{ artemis_netty_leak_detection_level }} \
    -XX:MaxDirectMemorySize={{ artemis_max_direct_memory_mb }}m \
    -XX:MaxMetaspaceSize={{ artemis_max_metaspace_mb }}m \
    -XX:+ShowCodeDetailsInExceptionMessages \
    -XX:+HeapDumpOnOutOfMemoryError \
    --add-modules java.se \
    --add-exports java.base/jdk.internal.ref=ALL-UNNAMED \
    --add-exports java.naming/com.sun.jndi.ldap=ALL-UNNAMED \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    --add-opens java.base/java.nio=ALL-UNNAMED \
    --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
    --add-opens java.management/sun.management=ALL-UNNAMED \
    --add-opens jdk.management/com.sun.management.internal=ALL-UNNAMED \
    -jar artemis.war \
    --spring.profiles.active={{ artemis_spring_profiles }}
SuccessExitStatus=143
#StandardOutput=file:{{ artemis_working_directory }}/artemis.log
StandardError=inherit

[Install]
WantedBy=multi-user.target

