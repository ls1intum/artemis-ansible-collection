#!/usr/bin/env bash
set -euo pipefail

REPOSITORY_URL="{{ pyris_repository_url }}"
REPOSITORY_DIR="{{ pyris_repository_directory }}"
STAGED_REPOSITORY_DIR="${REPOSITORY_DIR}.new"
PROJECT_DIR="${REPOSITORY_DIR}/iris/docker"
COMPOSE_FILE="{{ pyris_compose_file }}"
STABLE_ENV_FILE="{{ pyris_stable_env_file }}"
RUNTIME_ENV_FILE="{{ pyris_runtime_env_file }}"

# Function: Print general usage information
function general_help {
    cat << HELP
Usage:
  ./$(basename "$0") <command> [options]

Commands:
  start <pr_tag> <pr_branch>      Start Pyris, Nginx and the database
  stop                            Stop the Pyris server. Nginx and database will remain started
  restart <pr_tag> <pr_branch>    Restart the Pyris server. Nginx and database are unaffected
  run <docker compose cmd>        Run any docker compose subcommand of your choice
HELP
}

function prepare_checkout {
  local pr_branch=${1:?Git branch is required}

  rm -rf "$STAGED_REPOSITORY_DIR"
  git clone --branch "$pr_branch" --single-branch \
    "$REPOSITORY_URL" "$STAGED_REPOSITORY_DIR"
  if [ ! -f "$STAGED_REPOSITORY_DIR/iris/docker/$COMPOSE_FILE" ]; then
    echo "The requested branch does not contain $COMPOSE_FILE" >&2
    rm -rf "$STAGED_REPOSITORY_DIR"
    return 1
  fi
}

function activate_checkout {
  rm -rf "$REPOSITORY_DIR"
  mv "$STAGED_REPOSITORY_DIR" "$REPOSITORY_DIR"
}

function set_runtime_tag {
  local pr_tag=${1:?Docker tag is required}
  local runtime_tmp

  if grep -q '^PYRIS_DOCKER_TAG=' "$RUNTIME_ENV_FILE"; then
    runtime_tmp=$(mktemp "${RUNTIME_ENV_FILE}.XXXXXX")
    sed "s/^PYRIS_DOCKER_TAG=.*/PYRIS_DOCKER_TAG='$pr_tag'/" \
      "$RUNTIME_ENV_FILE" > "$runtime_tmp"
    # Preserve the deployment user's ownership and mode on runtime.env.
    cat "$runtime_tmp" > "$RUNTIME_ENV_FILE"
    rm -f "$runtime_tmp"
  else
    printf "PYRIS_DOCKER_TAG='%s'\n" "$pr_tag" >> "$RUNTIME_ENV_FILE"
  fi
}

function start_prepared {
  local pr_tag=${1:?Docker tag is required}

  set_runtime_tag "$pr_tag"
  docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/$COMPOSE_FILE" \
    --env-file "$STABLE_ENV_FILE" --env-file "$RUNTIME_ENV_FILE" \
    up -d --pull always --no-build
}

function start {
  local pr_tag=${1:?Docker tag is required}
  local pr_branch=${2:?Git branch is required}

  echo "Starting Pyris with PR tag: $pr_tag and branch: $pr_branch"
  prepare_checkout "$pr_branch"
  activate_checkout
  start_prepared "$pr_tag"
}

function stop {
  echo "Stopping Pyris"
  if [ ! -f "$PROJECT_DIR/$COMPOSE_FILE" ]; then
    echo "No active Pyris checkout found; skipping stop"
    return 0
  fi
  docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/$COMPOSE_FILE" \
    --env-file "$STABLE_ENV_FILE" --env-file "$RUNTIME_ENV_FILE" stop pyris-app
}

function restart {
  local pr_tag=${1:?Docker tag is required}
  local pr_branch=${2:?Git branch is required}

  echo "Restarting Pyris with PR tag: $pr_tag and branch: $pr_branch"
  # Clone and validate before stopping the current container. A missing or
  # invalid branch therefore cannot interrupt the running deployment.
  prepare_checkout "$pr_branch"
  stop
  activate_checkout
  start_prepared "$pr_tag"
}

function pyris_logs {
   docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/$COMPOSE_FILE" \
     --env-file "$STABLE_ENV_FILE" --env-file "$RUNTIME_ENV_FILE" logs -f pyris-app
}

function all_logs {
   docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/$COMPOSE_FILE" \
     --env-file "$STABLE_ENV_FILE" --env-file "$RUNTIME_ENV_FILE" logs -f
}

function run_docker_compose_cmd {
   docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/$COMPOSE_FILE" \
     --env-file "$STABLE_ENV_FILE" --env-file "$RUNTIME_ENV_FILE" "$@"
}

# read subcommand `pyris-docker subcommand server` in variable and remove base command from argument list
subcommand=$1; shift

# Handle empty subcommand
if [ -z "$subcommand" ]; then
    general_help
    exit 1
fi

case "$subcommand" in
    start)
        start "$@"
        ;;
    stop)
        stop "$@"
        ;;
    restart)
        restart "$@"
        ;;
    logs-pyris)
        pyris_logs "$@"
        ;;
    logs)
        all_logs "$@"
        ;;
    run)
        run_docker_compose_cmd "$@"
        ;;
    *)
        printf "Invalid Command: %s\n\n" "$subcommand" 1>&2
        general_help
        exit 1
        ;;
esac
